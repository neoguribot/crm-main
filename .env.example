# 이 파일은 필요한 환경변수의 "이름"만 기록한다. 실제 값이나 비밀키를 넣지 않는다.
# 실제 값은 .env.local 에 두며 Git 에 커밋하지 않는다.

# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 공개(anon) 키 — 브라우저에 노출되어도 되는 키. RLS 로 접근을 통제한다.
# 참고: Supabase 가 새로 도입한 "publishable key"(sb_publishable_...) 를 쓰는 경우
#       변수명을 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY 로 둘 수 있다. 현재는 anon 키 방식을 사용한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role(비밀) 키는 서버 전용이며, 후속 단계에서 필요할 때 추가한다.
# 절대로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
